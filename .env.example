# Copy to .env. All settings use the VS_ prefix.
VS_HOST=0.0.0.0
VS_PORT=8000
VS_LOG_LEVEL=INFO

VS_MAX_STREAMS=8
VS_DEFAULT_FPS=15
VS_JPEG_QUALITY=80

# Only files under this directory can be streamed
VS_MEDIA_DIR=media
# HLS segments; point at tmpfs (/dev/shm/vs_hls) in production
# VS_HLS_DIR=/dev/shm/vs_hls

VS_FFMPEG_PATH=ffmpeg
VS_HLS_SEGMENT_SECONDS=2
VS_HLS_LIST_SIZE=5

# 0 = retry forever
VS_MAX_RECONNECT_ATTEMPTS=0
VS_RECONNECT_INITIAL_DELAY=1
VS_RECONNECT_MAX_DELAY=30
VS_RTSP_TIMEOUT_SECONDS=5

# Login (HTTP Basic). Enabled when a password is set. Strongly recommended beyond localhost.
# VS_AUTH_USER=admin
# VS_AUTH_PASSWORD=change-me

# Live voice
VS_MAX_LISTENERS=50
# Extra origins allowed to open voice WebSockets (same-origin always works), JSON list:
# VS_ALLOWED_ORIGINS=["https://my.site"]
